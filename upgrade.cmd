@echo off & setlocal EnableExtensions DisableDelayedExpansion & cls & set "REPO_DIR=%~dp0." & set "TEMP_CLONE=%TEMP%\YTPrintScreen-upgrade-clone-%RANDOM%-%RANDOM%" & set "TEMP_RUNNER=%TEMP%\YTPrintScreen-upgrade-runner-%RANDOM%-%RANDOM%.ps1" & git clone --quiet --depth 1 --branch devel "https://github.com/Suenee/YTPrintScreen.git" "%TEMP_CLONE%" && copy /y "%TEMP_CLONE%\upgrade.ps1" "%TEMP_RUNNER%" >nul && powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$p=$env:TEMP_RUNNER;$t=[IO.File]::ReadAllText($p,[Text.Encoding]::UTF8);[IO.File]::WriteAllText($p,$t,(New-Object Text.UTF8Encoding($true)))" && powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%TEMP_RUNNER%" -RepositoryPath "%REPO_DIR%" -SourcePath "%REPO_DIR%" -TargetBranch "devel" -RepositoryUrl "https://github.com/Suenee/YTPrintScreen.git" -UpdaterRevision "1.04" & set "RC=%ERRORLEVEL%" & if exist "%TEMP_RUNNER%" del /q "%TEMP_RUNNER%" >nul 2>&1 & if exist "%TEMP_CLONE%\" rmdir /s /q "%TEMP_CLONE%" >nul 2>&1 & exit /b %RC%