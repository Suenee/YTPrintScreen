@echo off & setlocal EnableExtensions DisableDelayedExpansion & set "YTPS_REPO=%~dp0." & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$repo=[IO.Path]::GetFullPath($env:YTPS_REPO);$tmp=Join-Path $env:TEMP ('YTPrintScreen-upgrade-'+[guid]::NewGuid().ToString('N'));try{git clone --quiet --depth 1 --branch devel 'https://github.com/Suenee/YTPrintScreen.git' $tmp;if($LASTEXITCODE -ne 0){throw 'Nelze stáhnout autoritativní updater.'};$runner=Join-Path $tmp 'upgrade.ps1';& $runner -RepositoryPath $repo -SourcePath $repo -TargetBranch 'devel' -RepositoryUrl 'https://github.com/Suenee/YTPrintScreen.git' -UpdaterRevision '1.06';$rc=$LASTEXITCODE;if($null -eq $rc){$rc=0}}catch{Write-Host ('ERROR: '+$_.Exception.Message) -ForegroundColor Red;$rc=1}finally{if(Test-Path -LiteralPath $tmp){Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue}};exit $rc"